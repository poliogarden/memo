<Window x:Class="StickBrain.App.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture"
        Width="420"
        Height="140"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True">
    <Border Margin="10" Padding="8" CornerRadius="6" Background="#FF1E1E1E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="Write &amp; Enter"
                       Foreground="#77FFFFFF"
                       Margin="0,0,0,6"
                       FontSize="12"/>
            <TextBox x:Name="InputBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontSize="14"
                     VerticalScrollBarVisibility="Auto"
                     Background="#FF2B2B2B"
                     Foreground="White"
                     BorderBrush="#444"
                     BorderThickness="1"
                     Padding="4"
                     KeyDown="InputBox_OnKeyDown"/>
        </Grid>
    </Border>
</Window>

